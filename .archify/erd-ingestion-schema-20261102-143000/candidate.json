  "cards": [
    {
      "dot": "cyan",
      "title": "Storage details",
      "items": [
        "The User row includes its concrete fields inherited from AbstractUser plus TimestampedModel; implicit many-to-many auth join tables are outside this pipeline scope.",
        "The Trace row contains metadata only. The trace payload is an artifact addressed by storage_key and storage_backend.",
        "Types shown are PostgreSQL-equivalent SQL types derived from Django fields; nullable fields are optional. Link.current_trace_id is nullable; session references on Trace and CaptureSession are nullable."
      ]
    },
    {
      "dot": "amber",
      "title": "Constraints",
      "items": [
        "Site.company_id is one-to-one and therefore unique.",
        "A Link is unique within a Site by (site_id, url_hash).",
        "TableClassification has one row per extracted table; its table_id is both FK and unique key.",
        "PlanRecord has a unique (link_id, natural_key) constraint. ExtractedTableRow has a unique (table_id, row_index) constraint."
      ]
    }
  ]
}
